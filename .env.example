# Generado automáticamente por `npx convex dev` en .env.local (no se commitea).
# Cópialo aquí solo como referencia de qué variables necesita el proyecto.
NEXT_PUBLIC_CONVEX_URL=

# Solo para el entorno de Railway (no en local): deploy key del deployment de
# PRODUCCIÓN de Convex. Se genera desde el dashboard de Convex → el proyecto →
# deployment de producción → Settings → Deploy Keys. `railway.json` lo usa
# para que `npx convex deploy` publique las funciones sin login interactivo y
# calcule NEXT_PUBLIC_CONVEX_URL automáticamente en cada build — no hace falta
# fijar NEXT_PUBLIC_CONVEX_URL a mano en Railway, el build lo genera solo.
CONVEX_DEPLOY_KEY=

# Variables de Convex Auth (se fijan con `npx convex env set <NOMBRE> <valor>`
# en cada deployment — dev y prod son independientes — no van en .env.local
# ni se leen desde Next.js):
# - JWT_PRIVATE_KEY, JWKS: se generan una vez por deployment con el script de
#   claves de Convex Auth.
# - AUTH_RESEND_KEY: API key de la cuenta de Resend, usada para enviar el
#   código de recuperación de contraseña (ver convex/ResendOTPPasswordReset.ts).
# - AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET: credenciales OAuth del cliente de
#   Google Cloud Console (login con Google, HOP-68, ver convex/auth.ts).
# - SITE_URL: URL pública del frontend (http://localhost:3000 en dev, la de
#   Railway en prod) — usada por convex-dev/auth para volver a la app tras el
#   login con Google.
